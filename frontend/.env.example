# Copy to .env.local. The front end holds no secrets: never put an API key here.

# Where the FastAPI backend runs. /api/* is proxied there by next.config.ts.
BACKEND_URL=http://localhost:8000

# 1 = when the backend can't answer, offer a clearly labeled sample instead of only an error.
# 0 = errors only.
NEXT_PUBLIC_DEMO_MODE=1

# 1 = show the /states page (every status banner and failure screen) in a production build, for screenshots.
# Leave unset in the public deploy. It is always on in `npm run dev`.
NEXT_PUBLIC_SHOW_STATES=
