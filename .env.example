# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Current stable Flash id as of 2026-11-22 (https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-3.8-flash
# USD per 1M tokens for gemini-3.8-flash paid tier through 2026-12-31 (output includes thinking). Used only for cost estimates.
GEMINI_PRICE_IN_PER_M=0.75
GEMINI_PRICE_OUT_PER_M=3.75
