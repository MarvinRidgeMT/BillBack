# Copy to .env and fill in. Never commit .env.
# Provider: anthropic (default) or gemini
LLM_PROVIDER=anthropic

# Anthropic (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=medium

# Optional: Gemini instead of Claude (set LLM_PROVIDER=gemini; key from aistudio.google.com/api-keys)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional cost-estimate override, USD per 1M tokens. Built-in default for claude-sonnet-5-5 is $2 in / $10 out
# (https://platform.claude.com/docs/en/about-claude/pricing, checked 2026-11-22)
PRICE_IN_PER_M=
PRICE_OUT_PER_M=

# Demo switches (see backend/demo_mode.py)
# 1 = policies only from cache/policies (no model call for policies)
DEMO_CACHE_ONLY=0
# 1 = bills only from cache/bills (the 10 fictional sample bills); no model call at all
BILL_CACHE_ONLY=0
# 0 = turn off reading a policy from a URL (live mode, beta)
LIVE_MODE=1
