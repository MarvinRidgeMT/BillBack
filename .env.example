# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Current stable Flash id as of 2026-11-22 (https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-3.8-flash
# Optional: USD per 1M tokens, used only to estimate cost in CLI output
GEMINI_PRICE_IN_PER_M=
GEMINI_PRICE_OUT_PER_M=
